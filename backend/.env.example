#Шаблон файла .env
#Скопируйте .env.example в .env (или создай сам .env папке /backend) и укажите свои данные - это нужно для локального запуска

DB_HOST=localhost # Хост бд
DB_PORT=5432 # Порт PostgreSQL (обычно 5432, может быть другой)
DB_USER=postgres # Имя пользователя БД
DB_PASSWORD=12345 # Пароль (указать свой!)
DB_NAME=umny_kan_db # Имя бд

PORT=3000 # Порт, на котором запускается NestJS

JWT_SECRET=your_secret_key   # Секретный ключ для подписи JWT-токенов

ENCRYPTION_KEY=45f4fdca7ce8f57d00497df3b7375e7fed8653271a0bba9527b0d39301084c00

AI_MOCK_MODE=false